From 2e2bb1ae5611df199c50d6f4e9a8ec823c45e9e4 Mon Sep 17 00:00:00 2001
From: rbc <rbc@localhost>
Date: Tue, 17 Nov 2026 06:31:13 +0000
Subject: [PATCH] Enable location adverts on Xiao nRF52840 (map visibility)

The xiao_nrf52 variant stripped ENV_INCLUDE_GPS at compile time, so the
board could not embed coordinates in adverts - repeaters built from it
show lat 0/long 0 on meshcore.pt and meshcore.io maps (43 of 709 PT
nodes are coordless largely for this same reason).

Remove the strip and add the board plumbing that flag-on builds require
(pattern from heltec_t114, an nRF52840 board that ships GPS-flag-on
with no GPS hardware):

- platformio.ini: drop -UENV_INCLUDE_GPS; define PIN_GPS_TX=31 and
  PIN_GPS_RX=30 (unpopulated NFC pads - every exposed pin is taken by
  the radio, RTC I2C, or SPI) plus ENV_SKIP_GPS_DETECT (no GPS hardware
  is attached, skip the 5 s boot probe)
- target.cpp: construct EnvironmentSensorManager with a
  MicroNMEALocationProvider on Serial1 (idles forever - nothing is
  wired to the NFC pads)

No GPS hardware needed at runtime: 'gps advert prefs' broadcasts the
stored lat/lon, which is what map dots are derived from.
---
 variants/xiao_nrf52/platformio.ini | 7 ++++++-
 variants/xiao_nrf52/target.cpp     | 7 +++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/variants/xiao_nrf52/platformio.ini b/variants/xiao_nrf52/platformio.ini
index b40ebbc..ccc2ae6 100644
--- a/variants/xiao_nrf52/platformio.ini
+++ b/variants/xiao_nrf52/platformio.ini
@@ -7,7 +7,12 @@ build_flags = ${nrf52_base.build_flags}
   -I lib/nrf52/s140_nrf52_7.3.0_API/include
   -I lib/nrf52/s140_nrf52_7.3.0_API/include/nrf52
   -I variants/xiao_nrf52
-  -UENV_INCLUDE_GPS
+  ; location-adverts enabled (was: -UENV_INCLUDE_GPS). No GPS hardware on this
+  ; board: Serial1 parked on the unpopulated NFC pads, detection skipped.
+  ; advert coords come from stored lat/lon via `gps advert prefs`.
+  -D PIN_GPS_TX=31
+  -D PIN_GPS_RX=30
+  -D ENV_SKIP_GPS_DETECT
   -D NRF52_PLATFORM
   -D XIAO_NRF52
   -D USE_SX1262
diff --git a/variants/xiao_nrf52/target.cpp b/variants/xiao_nrf52/target.cpp
index def1dbb..7cf7a59 100644
--- a/variants/xiao_nrf52/target.cpp
+++ b/variants/xiao_nrf52/target.cpp
@@ -16,7 +16,14 @@ WRAPPER_CLASS radio_driver(radio, board);
 VolatileRTCClock fallback_clock;
 AutoDiscoverRTCClock rtc_clock(fallback_clock);
 
+// location support (no GPS hardware: provider idles, coords come from prefs)
+#if ENV_INCLUDE_GPS
+#include <helpers/sensors/MicroNMEALocationProvider.h>
+MicroNMEALocationProvider nmea = MicroNMEALocationProvider(Serial1, &rtc_clock);
+EnvironmentSensorManager sensors = EnvironmentSensorManager(nmea);
+#else
 EnvironmentSensorManager sensors;
+#endif
 
 bool radio_init() {
   rtc_clock.begin(Wire);
-- 
